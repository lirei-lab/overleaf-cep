#!/bin/bash

NODE_PARAMS=""
if [ "$DEBUG_NODE" == "true" ]; then
    echo "running debug - clsi"
    NODE_PARAMS="--inspect=0.0.0.0:30130"
fi

# Set permissions on docker.sock if present,
# To enable sibling-containers (see entrypoint.sh in clsi project)
if [ -e '/var/run/docker.sock' ]; then
  echo ">> Setting permissions on docker socket"
  DOCKER_GROUP=$(stat -c '%g' /var/run/docker.sock)
  groupadd --non-unique --gid "${DOCKER_GROUP}" dockeronhost
  usermod -aG dockeronhost www-data
fi

source /etc/overleaf/env.sh
export LISTEN_ADDRESS=127.0.0.1

# LIREI hardening (no sandboxed compiles on Kubernetes): every compile inherits
# CLSI's environment, so user LaTeX could read these with Lua's os.getenv().
# CLSI itself uses none of them.
unset OT_JWT_AUTH_KEY OVERLEAF_EMAIL_AUTH_PASS OVERLEAF_INVITE_TOKEN_SECRET \
  OVERLEAF_OIDC_CLIENT_SECRET STAGING_PASSWORD V1_HISTORY_PASSWORD WEB_API_PASSWORD
# kpathsea "paranoid": \input and friends may not open absolute paths, parent
# directories or dot files, so a project cannot read other projects' compile
# dirs, /proc/*/environ or the config. Side effect: lualatex fails (luaotfload
# reads its cache by absolute path); pdflatex and xelatex are unaffected.
export openin_any=p

exec /sbin/setuser www-data /usr/bin/node $NODE_PARAMS /overleaf/services/clsi/app.js >> /var/log/overleaf/clsi.log 2>&1
